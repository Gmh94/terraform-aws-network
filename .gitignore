# Terraform state files
*.tfstate
*.tfstate.*

# Terraform working directory
.terraform/

# Terraform variable files that may contain secrets
*.tfvars
*.tfvars.json

# Terraform crash logs
crash.log
crash.*.log

# Terraform override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Local Terraform CLI configuration
.terraformrc
terraform.rc

# Saved Terraform plans
*.tfplan
